# Local development package for Projecteur.
#
# `just package` creates the two local sources below in a staging directory,
# updates their checksums, and invokes makepkg there.

pkgname=projecteur
pkgver=0
pkgrel=1
pkgdesc='Virtual laser pointer for inertial pointer devices on KDE Plasma Wayland'
arch=('x86_64')
url='https://github.com/jahnf/Projecteur'
license=('MIT')
depends=(
  'gcc-libs'
  'glibc'
  'layer-shell-qt>=6.7'
  'libglvnd'
  'qt6-base>=6.11'
  'qt6-declarative>=6.11'
)
makedepends=(
  'cmake>=3.20'
  'qt6-tools>=6.11'
)
source=(
  'projecteur-local.tar.gz'
  'projecteur-pkgver'
)
sha256sums=(
  'SKIP'
  'SKIP'
)

pkgver() {
  cat "$srcdir/projecteur-pkgver"
}

build() {
  cmake -S projecteur-local -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_UDEVRULESDIR=/usr/lib/udev/rules.d \
    -DPACKAGE_TARGETS=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 projecteur-local/LICENSE.md \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
